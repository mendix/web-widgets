{
    "name": "@mendix/combobox-kit",
    "version": "0.1.0",
    "description": "Headless combo box: the core with the Mendix binding, the view model contract, the Atlas view with its behavior, popover, classes and parts, and the conformance suite.",
    "copyright": "© Mendix Technology BV 2025. All rights reserved.",
    "license": "Apache-2.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/mendix/web-widgets.git"
    },
    "type": "module",
    "types": "./dist/main.d.ts",
    "main": "./dist/main.js",
    "files": [
        "dist",
        "!*.map"
    ],
    "exports": {
        ".": "./dist/main.js",
        "./*": "./dist/*.js"
    },
    "typesVersions": {
        "*": {
            "dist/main.d.ts": [
                "dist/main.d.ts"
            ],
            "*": [
                "dist/*"
            ]
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "format": "prettier --write .",
        "lint": "eslint src/ package.json",
        "test": "jest"
    },
    "dependencies": {
        "@floating-ui/react": "^0.26.27",
        "@mendix/widget-kit": "workspace:*",
        "@mendix/widget-plugin-component-kit": "workspace:*",
        "@mendix/widget-plugin-grid": "workspace:*",
        "@mendix/widget-plugin-mobx-kit": "workspace:*",
        "@mendix/widget-plugin-platform": "workspace:*",
        "brandi": "^5.0.0",
        "classnames": "^2.5.1",
        "downshift": "^7.6.2",
        "match-sorter": "^8.1.0",
        "mobx": "6.12.3"
    },
    "devDependencies": {
        "@mendix/eslint-config-web-widgets": "workspace:*",
        "@mendix/pluggable-widgets-tools": "*",
        "@mendix/prettier-config-web-widgets": "workspace:*",
        "@mendix/widget-plugin-test-utils": "workspace:*"
    },
    "optionalDependencies": {
        "react": ">=18.0.0 <19.0.0"
    }
}
