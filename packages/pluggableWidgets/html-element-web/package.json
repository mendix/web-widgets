    },
    "config": {},
    "mxpackage": {
        "name": "HTMLElement",
        "type": "widget",
        "mpkName": "com.mendix.widget.web.HTMLElement.mpk"
    },
    "packagePath": "com.mendix.widget.web",
    "marketplace": {
        "minimumMXVersion": "9.12.0",
        "appName": "HTML Element",
        "appNumber": 204843,
        "reactReady": true
    },
    "testProject": {
        "githubUrl": "https://github.com/mendix/testProjects",
        "branchName": "html-element-web-atlas4",
        "atlasCoreVersion": "4.5.0",
        "atlasThemeTag": "atlasui-theme-files-2025-10-08"
    },
    "scripts": {
        "build": "pluggable-widgets-tools build:web",
        "create-gh-release": "rui-create-gh-release",
        "create-translation": "rui-create-translation",
        "dev": "pluggable-widgets-tools start:web",
        "e2e": "MENDIX_VERSION=11.15.0 MODERN_CLIENT=--modern-web-client run-e2e ci",
        "e2edev": "run-e2e dev --with-preps",
        "format": "prettier --ignore-path ./node_modules/@mendix/prettier-config-web-widgets/global-prettierignore --write .",
        "lint": "eslint src/ package.json",
        "publish-marketplace": "rui-publish-marketplace",
        "release": "pluggable-widgets-tools release:web",
        "start": "pluggable-widgets-tools start:server",
        "test": "pluggable-widgets-tools test:unit:web",
        "update-changelog": "rui-update-changelog-widget",
        "verify": "rui-verify-package-format"
